{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    // The same bar as the app. These two files configure the build and the
    // test runner, so a mistake in them is not cheaper than one in `src`.
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    // A composite project cannot disable emit; route build info aside instead.
    "emitDeclarationOnly": true,
    "declaration": true,
    "outDir": "./node_modules/.tmp/tsconfig-node",
    "types": ["node"]
  },
  "include": ["vite.config.ts", "vitest.config.ts"]
}
